# Database Connection
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Cookies
JWT_SECRET="studyforge-super-secret-jwt-key-change-in-production"

# AI Provider Configuration
# Set your Gemini API key below to enable live Google Gemini API generation.
# If omitted or left empty, StudyForge automatically runs in graceful mock/demo mode.
GEMINI_API_KEY=""

# Maximum File Upload Size (Bytes, default 20MB)
MAX_FILE_SIZE_BYTES=20971520
